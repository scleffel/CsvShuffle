<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <Import Project="Version.props"/>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
        <RootNamespace>CsvShuffle</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.*"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.*" PrivateAssets="all"/>
        <PackageReference Include="MudBlazor" Version="9.*"/>
    </ItemGroup>

    <ItemGroup>
        <ServiceWorker Include="wwwroot\\service-worker.js" PublishedContent="wwwroot\\service-worker.published.js"/>
    </ItemGroup>

    <Target Name="WriteBuildVersionManifest" AfterTargets="Build">
        <WriteLinesToFile File="$(OutputPath)wwwroot/version.json"
                          Lines="{&quot;version&quot;:&quot;$(Version)&quot;}"
                          Overwrite="true"/>
    </Target>

    <Target Name="WritePublishedVersionManifest" AfterTargets="Publish">
        <WriteLinesToFile File="$(PublishDir)wwwroot/version.json"
                          Lines="{&quot;version&quot;:&quot;$(Version)&quot;}"
                          Overwrite="true"/>
    </Target>

</Project>
