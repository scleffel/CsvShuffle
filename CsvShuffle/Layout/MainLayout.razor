@inherits LayoutComponentBase
@inject IJSRuntime Js
@implements IAsyncDisposable

<MudThemeProvider Theme="@_theme"
                  IsDarkMode="IsDarkMode"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<CascadingValue Value="@this">
    @Body
</CascadingValue>

@code {
    MudTheme? _theme;
    ThemePreferenceInterop? _themePreferences;
    PwaUpdateInterop? _pwaUpdate;
    DotNetObjectReference<MainLayout>? _layoutReference;
    public string CurrentColorModeIcon = Icons.Material.Filled.AutoMode;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        _theme = new MudTheme
        {
            Typography = _typography,
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties()
        };
    }

    public ColorMode ColorMode { get; private set; } = ColorMode.System;

    public bool IsDarkMode { get; private set; } = true;
    public bool UpdateAvailable { get; private set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _themePreferences = new ThemePreferenceInterop(Js);
        _pwaUpdate = new PwaUpdateInterop(Js);
        _layoutReference = DotNetObjectReference.Create(this);
        var preference = await _themePreferences.InitializeAsync(_layoutReference);
        await _pwaUpdate.InitializeAsync(_layoutReference);

        if (Enum.TryParse(preference.Mode, ignoreCase: true, out ColorMode storedMode)
            && storedMode is ColorMode.Light or ColorMode.Dark)
            ColorMode = storedMode;

        IsDarkMode = ColorMode == ColorMode.Dark || ColorMode == ColorMode.System && preference.PrefersDark;

        UpdateColorModeIcon();
        StateHasChanged();
    }

    public async Task SetColorModeAsync(ColorMode colorMode)
    {
        ColorMode = colorMode;

        bool prefersDark = _themePreferences is null
            ? IsDarkMode
            : await _themePreferences.ApplyPreferenceAsync(colorMode);

        IsDarkMode = colorMode == ColorMode.Dark || colorMode == ColorMode.System && prefersDark;

        UpdateColorModeIcon();
        StateHasChanged();
    }

    public Task CycleColorModeAsync() => SetColorModeAsync(ColorMode switch
    {
        ColorMode.System => ColorMode.Light,
        ColorMode.Light => ColorMode.Dark,
        ColorMode.Dark => ColorMode.System,
        _ => throw new ArgumentOutOfRangeException(nameof(ColorMode), ColorMode, null)
    });

    void UpdateColorModeIcon()
    {
        CurrentColorModeIcon = ColorMode switch
        {
            ColorMode.Light => Icons.Material.Filled.LightMode,
            ColorMode.Dark => Icons.Material.Filled.DarkMode,
            ColorMode.System => Icons.Material.Filled.AutoMode,
            _ => throw new ArgumentOutOfRangeException(nameof(ColorMode), ColorMode, null)
        };
    }

    [JSInvokable]
    public async Task OnSystemColorSchemeChanged(bool prefersDark)
    {
        if (ColorMode != ColorMode.System)
            return;

        await InvokeAsync(() =>
        {
            IsDarkMode = prefersDark;
            StateHasChanged();
        });
    }

    [JSInvokable]
    public async Task OnPwaUpdateAvailable()
    {
        await InvokeAsync(() =>
        {
            UpdateAvailable = true;
            StateHasChanged();
        });
    }

    public async Task ApplyUpdateAsync()
    {
        if (_pwaUpdate is not null)
            await _pwaUpdate.ApplyUpdateAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_themePreferences is not null)
            await _themePreferences.DisposeAsync();

        if (_pwaUpdate is not null)
            await _pwaUpdate.DisposeAsync();

        _layoutReference?.Dispose();
    }

