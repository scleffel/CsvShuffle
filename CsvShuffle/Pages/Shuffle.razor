@page "/"
@inject IJSRuntime Js

<PageTitle>
    @($"v{AppVersion}")
</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge">
    <ShuffleTopBar AppVersion="@AppVersion"
                   Status="@HeaderStatus"
                   OnFileSelected="@LoadFile"/>

    <MudProgressLinear Color="Color.Primary"
                       Class="mb-2"
                       Striped="@_busy"
                       Value="@(_busy ? _progress : 0)"
                       Rounded/>

    @if (_headers.Count > 0)
    {
        <MudPaper Outlined
                  Class="pa-1 export-panel">
            <ShuffleToolbar FileName="@_fileName"
                            ColumnCount="@_headers.Count"
                            RowCount="@_rows.Count"
                            Busy="@_busy"
                            HasObfuscatedData="@(_obfuscatedGridRows.Count > 0)"
                            CanSave="@(_obfuscatedCsv is not null)"
                            ShowObfuscated="@_showObfuscated"
                            ShowObfuscatedChanged="@(value => _showObfuscated = value)"
                            Search="@_search"
                            SearchChanged="@(value => _search = value ?? string.Empty)"
                            OnClear="@ConfirmClearFile"
                            OnCancel="@Cancel"
                            OnObfuscate="@Obfuscate"
                            OnSave="@Download"/>
            <ShuffleDataGrid Headers="@_headers"
                             Rows="@VisibleGridRows"
                             Modes="@_modes"
                             Search="@_search"
                             OnModeChanged="@(change => SetObfuscationMode(change.ColumnIndex, change.Mode))"/>
        </MudPaper>
    }
</MudContainer>

@code {
    [CascadingParameter] public MainLayout Layout { get; set; } = null!;
}
