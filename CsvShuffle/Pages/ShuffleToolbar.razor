<MudStack Spacing="2" Class="mb-1">

    <MudStack Row AlignItems="AlignItems.Center"
              Justify="Justify.SpaceBetween">

        <MudStack Row Spacing="2"
                  AlignItems="AlignItems.Center">
            <MudChip T="string"
                     Style="font-family: monospace;"
                     Variant="Variant.Outlined"
                     Color="Color.Tertiary"
                     Label="true">
                @FileName
            </MudChip>
            <MudChip T="string"
                     Color="Color.Secondary">
                @ColumnCount columns
            </MudChip>
            <MudChip T="string"
                     Color="Color.Secondary">
                @RowCount.ToString("N0") rows
            </MudChip>
            <MudTooltip Text="@($"Drop {FileName}")">
                <MudIconButton Color="Color.Error"
                               Icon="@Icons.Material.Filled.DeleteForever"
                               Disabled="@Busy"
                               aria-label="@($"Drop {FileName}")"
                               OnClick="@OnClear"/>
            </MudTooltip>
        </MudStack>

        <MudStack Row Spacing="2"
                  AlignItems="AlignItems.Center">
            <MudSwitch Value="@ShowObfuscated"
                       ValueChanged="@ShowObfuscatedChanged"
                       Color="Color.Primary"
                       Disabled="@(!HasObfuscatedData)">
                @(ShowObfuscated ? "Scrambled" : "Original")
            </MudSwitch>
            <MudTextField Value="@Search"
                          ValueChanged="@SearchChanged"
                          Margin="Margin.Dense"
                          Immediate
                          aria-label="Search all columns"
                          Placeholder="Search all columns"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Class="global-search"/>
            @if (Busy)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Class="px-5"
                           StartIcon="@Icons.Material.Filled.Cancel"
                           OnClick="@OnCancel">
                    Cancel
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Class="px-5"
                           StartIcon="@Icons.Material.Filled.Shuffle"
                           OnClick="@OnObfuscate">
                    Obfuscate
                </MudButton>
            }
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       Class="px-5 me-1"
                       StartIcon="@Icons.Material.Filled.Download"
                       Disabled="@(Busy || !CanSave)"
                       OnClick="@OnSave">
                Save
            </MudButton>
        </MudStack>
    </MudStack>
</MudStack>

@code {
    [Parameter] public string FileName { get; set; } = null!;
    [Parameter] public int ColumnCount { get; set; }
    [Parameter] public int RowCount { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool HasObfuscatedData { get; set; }
    [Parameter] public bool CanSave { get; set; }
    [Parameter] public bool ShowObfuscated { get; set; }
    [Parameter] public EventCallback<bool> ShowObfuscatedChanged { get; set; }
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public EventCallback<string?> SearchChanged { get; set; }
    [Parameter] public EventCallback OnClear { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnObfuscate { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
}
